# Postgres connection string (Neon or Supabase pooled URL)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Public site URL, no trailing slash (used for SEO, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://example.com

# Bakehouse dashboard login
ADMIN_PASSWORD=change-me
# Random 32+ char string used to sign the admin session cookie
ADMIN_SECRET=replace-with-a-long-random-string

# Optional
NEXT_PUBLIC_PICKUP_ADDRESS=Mémoire Bakehouse, Gurgaon, Haryana
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
